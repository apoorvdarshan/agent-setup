{
  "permissions": {
    "allow": [
      "Shell(ls)"
    ],
    "deny": []
  },
  "version": 1,
  "editor": {
    "vimMode": false
  },
  "display": {
    "showLineNumbers": false,
    "showThinkingBlocks": false,
    "showStatusIndicators": false,
    "showStatusLineRunningTime": false,
    "mode": "zen"
  },
  "notifications": true,
  "hints": true,
  "modelSlashCommands": true,
  "steering": true,
  "rewind": true,
  "model": {
    "modelId": "default",
    "displayModelId": "auto",
    "displayName": "Auto",
    "displayNameShort": "Auto",
    "aliases": [
      "auto"
    ],
    "maxMode": false
  },
  "hasChangedDefaultModel": true,
  "modelParameters": {
    "default": []
  },
  "selectedModel": {
    "modelId": "default",
    "parameters": []
  },
  "exploreSubagentModel": "default",
  "network": {
    "useHttp1ForAgent": false
  },
  "approvalMode": "allowlist",
  "autoAcceptWebSearch": false,
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  },
  "runEverythingSettingsPromptStreak": 0,
  "attribution": {
    "attributeCommitsToAgent": true,
    "attributePRsToAgent": true
  }
}
