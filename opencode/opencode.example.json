{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "agent-browser": {
      "command": [
        "/opt/homebrew/bin/agent-browser",
        "mcp",
        "--tools",
        "core,state,tabs"
      ],
      "enabled": true,
      "type": "local"
    },
    "cua-driver": {
      "command": [
        "/Users/apoorvdarshan/.local/bin/cua-driver",
        "mcp",
        "--grant",
        "existing-profile"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "*": "allow",
    "doom_loop": "allow",
    "external_directory": "allow"
  },
  "plugin": []
}
